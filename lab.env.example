# Скопіюй у lab.env (він у .gitignore) або задай як секрети GitHub Actions.
LAB_HOST=app.example.com
LAB_DOMAIN=app.example.com
LAB_SSH_USER=deploy
LAB_SSH_PORT=22
# Якщо доступ лише через bastion:
BASTION_HOST=deploy@bastion.example.com
# Руйнівні перевірки (reboot). Умикай свідомо:
ALLOW_DESTRUCTIVE=0

# Для інцидентів етапів 4–6
LAB_RG=rg-app-dev
LAB_REPO=youruser/yourrepo
LAB_KUBE_CONTEXT=aks-dev
LAB_NAMESPACE=app-dev
